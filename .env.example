# Postgres connection (see "Install Postgres and Redis" in the README)
DATABASE_URL=postgres://sky:sky@localhost:5432/sky_holidays

# Redis for staff sessions, page caching and form rate limits.
# Optional: without it sessions and cache are kept in Postgres and form rate limits are skipped.
REDIS_URL=redis://localhost:6379

# Optional live data providers. Leave blank to use the seeded data in Postgres.
# Flights: Duffel (free test mode) https://duffel.com
DUFFEL_ACCESS_TOKEN=
# Excursions/attractions: OpenTripMap (free key) https://dev.opentripmap.org
OPENTRIPMAP_API_KEY=
# Hotels from OpenStreetMap need no key. Override the Overpass endpoint if you self-host.
OVERPASS_URL=https://overpass-api.de/api/interpreter

# Express API
API_PORT=4000
# Where uploaded photos, logos and payment slips are stored on disk.
UPLOAD_DIR=./uploads
# Long random string used to encrypt saved secrets (SMTP password, gateway keys). Keep it stable.
APP_SECRET=
# First Owner account created by `npm run db:seed-admin` (password printed once if left blank).
ADMIN_EMAIL=info@skyholidays.pk
ADMIN_NAME=
ADMIN_PASSWORD=
# Public address used in emailed document links (production), e.g. https://skyholidays.pk
PUBLIC_SITE_URL=
# Set to 1 only when testing the dashboard over plain http on a non-localhost host.
COOKIE_INSECURE=
