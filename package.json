{
  "name": "sky-holidays-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch server/index.js",
    "start": "node --env-file-if-exists=.env server/index.js",
    "check": "node scripts/check.js",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "db:seed": "node --env-file-if-exists=.env scripts/seed.js",
    "db:seed-admin": "node --env-file-if-exists=.env scripts/seed-admin.js",
    "db:seed-demo": "node --env-file-if-exists=.env scripts/seed-demo.js",
    "db:setup": "npm run db:migrate && npm run db:seed && npm run db:seed-admin"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "ioredis": "^6.0.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.1.0",
    "pg": "^8.23.1",
    "world-countries": "^5.1.0",
    "zod": "^4.6.6"
  },
  "engines": {
    "node": ">=22.9"
  }
}
